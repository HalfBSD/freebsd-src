#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Installation uses the live environment's network. The installed workstation
# discovers Ethernet and runs DHCP through halfinit, never through RC fragments.
set -eu
if ! /sbin/route -n get default >/dev/null 2>&1; then
    echo 'No default route. Configure the live environment network before continuing installation.' >&2
    exit 1
fi
echo 'Using the live network for installation; installed HalfBSD uses its DHCP-first service graph.'
