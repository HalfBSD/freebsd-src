# This file specifies various information about terminals on the system.
# It is used by several different programs.  Common entries for the
# various columns include:
#
# name  The name of the terminal device.
#
# getty The program to start running on the terminal.  HalfBSD starts
#       login through halfconsole;
#       init prepares its controlling terminal. Use
#       none when no login session is needed.
#
# type The initial terminal type for this port.  For hardwired
#      terminal lines, this will contain the type of terminal used.
#      The sole local console uses xterm.
#      Other common values include dialup for incoming modem ports, and
#      unknown when the terminal type cannot be predetermined.
#
# status Must be on or off.  If on, init will run the specified program on
#        the specified port.  If the word "secure" appears, this tty
#        allows root login.
#
# name	getty				type	status		comments
#
# PID 1 has no recovery shell; repair failed startup using external media.
console	none				unknown	off secure
#
# Lua mode uses console policy in /etc/halfbsd/system.lua (default root).
ttyv0	"/usr/sbin/halfconsole"		xterm	onifexists secure
