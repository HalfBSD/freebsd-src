PACKAGE=	locales
LOCALEDIR=	${SHAREDIR}/locale
FILESNAME=	LC_NUMERIC
.SUFFIXES:	.src .out

.src.out:
	grep -v -E '^(#$$|#[ ])' < ${.IMPSRC} > ${.TARGET}

