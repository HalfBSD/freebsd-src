LOCALES_MAPPED+=	fr_FR.ISO8859-15 fr_BE.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 eu_ES.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 eu_ES.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_ZA.US-ASCII
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_ZA.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_ZA.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_US.US-ASCII
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_US.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_US.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_SG.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_NZ.US-ASCII
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_NZ.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_NZ.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_IE.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_IE.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_HK.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_GB.US-ASCII
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_GB.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_GB.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_CA.US-ASCII
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_CA.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_CA.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_AU.US-ASCII
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_AU.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 en_AU.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 de_DE.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 de_DE.ISO8859-1
LOCALES_MAPPED+=	fr_FR.ISO8859-15 de_CH.ISO8859-15
LOCALES_MAPPED+=	fr_FR.ISO8859-15 de_CH.ISO8859-1
LOCALES_MAPPED+=	es_MX.ISO8859-1 es_ES.ISO8859-15
LOCALES_MAPPED+=	es_MX.ISO8859-1 es_ES.ISO8859-1
LOCALES_MAPPED+=	es_MX.ISO8859-1 es_AR.ISO8859-1
LOCALES_MAPPED+=	et_EE.ISO8859-15 et_EE.ISO8859-1
LOCALES_MAPPED+=	fi_FI.ISO8859-15 fi_FI.ISO8859-1
LOCALES_MAPPED+=	fr_CA.ISO8859-15 fr_CA.ISO8859-1

LOCALES+=	hy_AM.ARMSCII-8
LOCALES+=	hi_IN.ISCII-DEV
LOCALES+=	fr_CA.ISO8859-15
LOCALES+=	fi_FI.ISO8859-15
LOCALES+=	et_EE.ISO8859-15
LOCALES+=	es_MX.ISO8859-1
LOCALES+=	fr_FR.ISO8859-15
LOCALES+=	el_GR.ISO8859-7
LOCALES+=	hr_HR.ISO8859-2
LOCALES+=	hu_HU.ISO8859-2


FILES=		${LOCALES:S/$/.LC_COLLATE/}
CLEANFILES=	${FILES}

.for f t in ${SAME}
DIRS+=	LOCALEDIR_$t
LOCALEDIR_${t}PACKAGE=	locales
LOCALEDIR_$t=	${LOCALEDIR}/$t
SYMLINKS+=	../$f/${FILESNAME} \
    ${LOCALEDIR}/$t/${FILESNAME}
.endfor

.for f in ${LOCALES}
FILESDIR_${f}.LC_COLLATE= ${LOCALEDIR}/${f}
FILESDIR_${f}.LC_COLLATEPACKAGE=	locales
.endfor

.for f t in ${LOCALES_MAPPED}
FILES+=	$t.LC_COLLATE
FILESDIR_$t.LC_COLLATE=	${LOCALEDIR}/$t
FILESDIR_${t}.LC_COLLATEPACKAGE=	locales
$t.LC_COLLATE: ${.CURDIR}/$f.src
	localedef ${LOCALEDEF_ENDIAN} -D -U -i ${.ALLSRC} \
	-V ${CLDR_VERSION} \
		-f ${MAPLOC}/map.${.TARGET:T:R:E:C/@.*//} \
		${.OBJDIR}/${.TARGET:T:R}
.endfor

.include <bsd.prog.mk>
