. $(atf_get_srcdir)/../../common/vnet.subr

# Start a test-only TCP echo or fixed-response server in a jail.
# Jail cleanup terminates the listener and its connection handlers.
firewall_tcp_server()
{
	tcp_server_jail="$1"
	tcp_server_family="$2"
	tcp_server_port="$3"
	shift 3
	tcp_server_ready="$(pwd)/tcp-server-${tcp_server_jail}-${tcp_server_family}-${tcp_server_port}.ready"
	rm -f "${tcp_server_ready}"
	jexec "${tcp_server_jail}" "$(atf_get_srcdir)/../common/tcp_server" \
	    "-${tcp_server_family}" "${tcp_server_port}" "${tcp_server_ready}" "$@" \
	    > "${tcp_server_ready}.log" 2>&1 &
	tcp_server_pid=$!

	tcp_server_attempt=0
	while [ "${tcp_server_attempt}" -lt 50 ]; do
		[ -f "${tcp_server_ready}" ] && return
		kill -0 "${tcp_server_pid}" 2>/dev/null || break
		sleep 0.1
		tcp_server_attempt=$((tcp_server_attempt + 1))
	done
	cat "${tcp_server_ready}.log"
	atf_fail "TCP server did not start on port ${tcp_server_port}"
}

firewall_config()
{
	jname=$1
	shift
	fw=$1
	shift

	while [ $# -gt 0 ]; do
		if [ $(is_firewall "$1") -eq  1 ]; then
			current_fw="$1"
			shift
			filename=${current_fw}.rule
			cwd=$(pwd)
			if [ -f ${current_fw}.rule ]; then
				rm ${current_fw}.rule
			fi
		fi
		rule=$1
		echo $rule >> $filename
		shift
	done

	if [ ${fw} == "ipfw" ]; then
		jexec ${jname} ipfw -q -f flush
		jexec ${jname} ipfw -q -f table all destroy
		jexec ${jname} /bin/sh $cwd/ipfw.rule
	else
		atf_fail "$fw is not a valid firewall to configure"
	fi
}

firewall_cleanup()
{
	firewall=$1
	echo "Cleaning $firewall"
	vnet_cleanup
}

firewall_init()
{
	firewall=$1
	vnet_init

	if [ ${firewall} == "ipfw" ]; then
		if ! kldstat -q -m ipfw; then
			atf_skip "This test requires ipfw"
		elif [ $(sysctl -n net.inet.ip.fw.default_to_accept) -ne 1 ]; then
			atf_fail "ipfw tests require net.inet.ip.fw.default_to_accept=1 tunable"
		fi
	else
		atf_fail "$fw is not a valid firewall to initialize"
	fi

}

dummynet_init()
{
	firewall=$1

	if ! kldstat -q -m dummynet; then
		atf_skip "This test requires dummynet"
	fi

	case $firewall in
	ipfw)
		# Nothing. This is okay.
		;;
	*)
		atf_skip "${firewall} does not support dummynet"
		;;
	esac
}

nat_init()
{
	firewall=$1
	if [ ${firewall} == "ipfw" ]; then
		if ! kldstat -q -m ipfw_nat; then
			atf_skip "This test requires ipfw_nat"
		fi
	fi
}

is_firewall()
{
	if [ "$1" = "ipfw" ]; then
		echo 1
	else
		echo 0
	fi
}
