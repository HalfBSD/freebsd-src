# HalfBSD policies. Keep each policy in its own function so future VM NAT
# and server policies can add their own forwarding rules and explicit ending.

. /etc/rc.subr
. /etc/network.subr
load_rc_config ipfw

rm -f /var/run/ipfw.ready

firewall_mode=${1:-${firewall_mode:-workstation}}
case "${firewall_mode}" in
open|workstation|closed) ;;
*)
	echo "Unknown firewall mode: ${firewall_mode}" >&2
	exit 1
	;;
esac

# A failed command must not be reported as successful policy installation.
set -e
fwcmd="/sbin/ipfw -q"

setup_local()
{
	${fwcmd} add 100 allow ip from any to any via lo0
	${fwcmd} add 200 deny ip from any to 127.0.0.0/8
	${fwcmd} add 300 deny ip from 127.0.0.0/8 to any
	if afexists inet6; then
		${fwcmd} add 400 deny ip6 from any to ::1
		${fwcmd} add 500 deny ip6 from ::1 to any
	fi
}

policy_open()
{
	${fwcmd} add 65000 allow ip from any to any
}

policy_workstation()
{
	# IPv6 neighbor discovery and path MTU discovery are required even
	# before the first outbound connection can create state.
	if afexists inet6; then
		${fwcmd} add 1000 allow ipv6-icmp from :: to ff02::/16 icmp6types 135
		${fwcmd} add 1100 allow ipv6-icmp from fe80::/10 to any icmp6types 133,134,135,136
		${fwcmd} add 1200 allow ipv6-icmp from any to any icmp6types 1,2,3,4,135,136
	fi

	${fwcmd} add 2000 check-state
	# Network access policy belongs here, not in the DNS or SSH daemon.
	if [ -z "${firewall_trusted_networks}" ]; then
		# Default service reachability: DNS over UDP/TCP and SSH over TCP.
		${fwcmd} add 2500 allow udp from any to me 53 in keep-state
		${fwcmd} add 2600 allow tcp from any to me 22,53 in setup keep-state
	else
		for network in ${firewall_trusted_networks}; do
			${fwcmd} add 2500 allow udp from "${network}" to me 53 in recv "${firewall_trusted_interface}" keep-state
			${fwcmd} add 2600 allow tcp from "${network}" to me 22,53 in recv "${firewall_trusted_interface}" setup keep-state
		done
	fi
	# Outbound TCP, UDP (including DNS/NTP), and ping establish state.
	# Replies, including TCP teardown, use the check-state rule above.
	${fwcmd} add 3000 allow tcp from me to any out setup keep-state
	${fwcmd} add 3100 allow udp from me to any out keep-state
	${fwcmd} add 3200 allow icmp from me to any out keep-state
	if afexists inet6; then
		${fwcmd} add 3300 allow ipv6-icmp from me to any out keep-state
	fi

	# DHCP starts before the client has an address; its replies can be
	# broadcast and therefore cannot rely solely on outbound state.
	${fwcmd} add 4000 allow udp from 0.0.0.0 68 to 255.255.255.255 67 out
	${fwcmd} add 4100 allow udp from any 67 to me 68 in
	${fwcmd} add 4200 allow udp from any 67 to 255.255.255.255 68 in
	if afexists inet6; then
		${fwcmd} add 4300 allow udp from fe80::/10 546 to ff02::1:2 547 out
		${fwcmd} add 4400 allow udp from fe80::/10 547 to me 546 in
	fi
	# Permit error messages needed for IPv4 path MTU and routing feedback.
	${fwcmd} add 4500 allow icmp from any to me in icmptypes 3,11,12

	# Limit repetitive noise; ordinary allow rules do not log packets.
	${fwcmd} add 65000 deny log logamount 100 ip from any to any
}

policy_closed()
{
	# Only loopback is permitted.
	${fwcmd} add 65000 deny log logamount 100 ip from any to any
}

# Enable both protocol hooks and logging even when run directly. Only rules
# explicitly containing "log" produce log entries.
${SYSCTL} net.inet.ip.fw.verbose=1 >/dev/null
${SYSCTL} net.inet.ip.fw.enable=1 >/dev/null
if afexists inet6; then
	${SYSCTL} net.inet6.ip6.fw.enable=1 >/dev/null
fi

# Set 31 survives ordinary flushes and cannot be disabled. The guard also
# protects upgrades still running the older accepting kernel fallback.
if ! ${fwcmd} -S list 65534 2>/dev/null | grep -q '^65534 set 31 deny ip from any to any$'; then
	${fwcmd} add 65534 set 31 deny ip from any to any
fi

# Require both halves of the administrator-selected LAN policy. No interface
# discovery or implicit trust of private address ranges is performed.
if { [ -n "${firewall_trusted_networks}" ] && [ -z "${firewall_trusted_interface}" ]; } ||
    { [ -z "${firewall_trusted_networks}" ] && [ -n "${firewall_trusted_interface}" ]; }; then
	echo "Set both firewall_trusted_networks and firewall_trusted_interface, or neither" >&2
	exit 1
fi
case "${firewall_trusted_interface}" in
*[!a-zA-Z0-9_.-]*) echo "Invalid trusted interface" >&2; exit 1 ;;
esac
for network in ${firewall_trusted_networks}; do
	case "${network}" in
	*[!0-9./]*|"") echo "Invalid trusted IPv4 network: ${network}" >&2; exit 1 ;;
	esac
done

${fwcmd} -f flush
setup_local
policy_${firewall_mode}
# A failed install never creates the readiness marker.
: > /var/run/ipfw.ready
